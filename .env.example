# API the console talks to.
# Leave EMPTY for local work: calls then go to the dev server's own origin and
# are proxied to VITE_API_PROXY_TARGET, which sidesteps CORS. Set the real host
# for a deployed build.
VITE_API_URL=

# Where the dev proxy forwards /api (dev only; ignored by a build).
VITE_API_PROXY_TARGET=

# Cognito. These are public — they ship in the browser bundle.
# Never put an AWS access key or an app-client secret here; the app client is
# configured as a public client precisely so there is no secret to leak.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
